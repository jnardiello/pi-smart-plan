{
  "name": "pi-smart-plan",
  "version": "0.1.0",
  "description": "Read-only plan mode for pi: /plan <goal> dispatches the bundled plan skill, and edits/writes are blocked outside backlog/ until the user confirms exit",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "plan",
    "plan-mode",
    "planner"
  ],
  "license": "MIT",
  "author": "Jacopo Nardiello",
  "repository": {
    "type": "git",
    "url": "https://github.com/jnardiello/pi-smart-plan"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
